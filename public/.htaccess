# React Router handles routes like /admin or /shop in the browser, so on a
# reload the server must serve index.html for any path that isn't a real file.
# The PWA manifest — the server otherwise sends it as text/plain.
AddType application/manifest+json .webmanifest

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # One address for the site: www.hikariliving.in -> hikariliving.in. The API
  # only accepts requests from the origins it knows, and this keeps SEO on one URL.
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^(.*)$ https://%1/$1 [R=301,L]

  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>
